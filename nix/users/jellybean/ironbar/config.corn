let {
    $workspaces = {
        type = "workspaces"
        name_map.1 = "hi!"
        name_map.2 = "</>"
        name_map.3 = ":3"
        favorites = [ "1" "2" "3" ]
        all_monitors = true
    }

    $focused = {
        type = "focused"
        show_icon = true
        show_title = true
        icon_size = 16
        truncate = "end"
    }

    $battery = {
        type = "battery"
        show_if = "ls /sys/class/power_supply/ | grep --quiet '^BAT'"
    }

    $sys_info = {
        type = "sys_info"
        interval.memory = 30
        interval.cpu = 1
        interval.temps = 5
        interval.disks = 300
        interval.networks = 3
        format = [
            " {cpu_percent}% | {cpu_frequency} GHz | {temp_c@CPUTIN}°C"
            " {memory_used} / {memory_total} GB ({memory_available} | {memory_percent2}%) | {swap_used} / {swap_total} GB ({swap_free} | {swap_percent}%)"
            "󰋊 {disk_used#G@/:.1} / {disk_total#G@/:.1} GB ({disk_percent@/}%) | {disk_read} / {disk_write} MB/s"
            "󰓢 {net_down@enp39s0} / {net_up@enp39s0} Mbps"
            "󰖡 {load_average_1} | {load_average_5} | {load_average_15}"
            "󰥔 {uptime}"
        ]
    }

    $tray = { type = "tray" }
    $volume = { type = "volume" }
    $clock = { type = "clock" }

} in {
    margin.top = 8
    margin.right = 8
    margin.left = 8
    margin.front = 8
    position = "top"
    height = 20
    popup_autohide = true

    start = [ $workspaces ]
    center = [ $focused ]
    end = [ $battery $tray $volume $clock ]
}