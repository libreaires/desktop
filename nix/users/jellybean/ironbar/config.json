{
  "position": "top",
  "height": 20,
  "popup_autohide": true,
  "start": [
    { "type": "workspaces" }
  ],
  "center": [
    { "type": "clock", "format": "%H:%M" }
  ],
  "end": [
    { "type": "sys_info" },
    { "type": "volume" },
    { "type": "sys_info" },
    {
      "type": "battery",
      "format": "{percentage}%",
      "profiles": {
        "warning":  { "percent":  20 },
        "critical": {
          "when": { "percent":  5, "charging": false },
          "format": "[LOW] {percentage}%"
        }
      }
    }
  ]
}
